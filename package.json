{
  "name": "kwkr",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa": "node scripts/release-qa.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "build": "npm run qa && npm run typecheck && npm run lint && npm run test && next build",
    "verify": "npm run build",
    "test:browser": "playwright test",
    "audit": "npm audit --audit-level=moderate",
    "verify:release": "npm run verify && npm run test:browser && npm run audit"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "gsap": "^3.15.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.23",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
